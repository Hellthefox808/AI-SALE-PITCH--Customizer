# ==============================================================================
# PitchCraft AI — Enterprise Environment Configuration Template
# Copy to .env and configure secrets prior to deployment
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Listening Port
PORT=4000

# Cryptographically Secure JWT Signing Key (Minimum 32 Characters)
JWT_SECRET=dev-pitchcraft-jwt-secret-replace-with-secure-key-in-production

# SQLite Database Storage Location
DB_PATH=./backend/sales_pitch.db

# Allowed CORS Origins (Comma-separated for multiple origins, or '*' for open)
CORS_ORIGIN=*

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
